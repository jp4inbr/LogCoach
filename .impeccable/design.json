  "components": [
    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A ação principal de cada tela, em pílula.",
      "html": "<button class=\"ds-btn-primary\">Analisar</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;font:inherit;font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;font-weight:600;cursor:pointer;transition:background-color .2s ease,border-color .2s ease;background:var(--accent);border:1px solid var(--accent);color:var(--accent-ink);}.ds-btn-primary:hover{background:var(--accent-strong);border-color:var(--accent-strong);}.ds-btn-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Botão padrão",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Ações comuns; a borda assume o destaque ao passar o mouse.",
      "html": "<button class=\"ds-btn\">Escolher outra luta</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;font:inherit;font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;font-weight:600;cursor:pointer;transition:background-color .2s ease,border-color .2s ease;background:var(--surface-2);border:1px solid var(--border);color:var(--text);}.ds-btn:hover{border-color:var(--accent-fg);}.ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Botão vazado",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Ações secundárias sobre o fundo.",
      "html": "<button class=\"ds-btn-ghost\">Criar conta grátis</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;font:inherit;font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;font-weight:600;cursor:pointer;transition:background-color .2s ease,border-color .2s ease;background:transparent;border:1px solid var(--border);color:var(--text);}.ds-btn-ghost:hover{border-color:var(--accent-fg);}.ds-btn-ghost:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Campo do link em pílula",
      "kind": "input",
      "refersTo": "link-pill",
      "description": "Campo do link com o botão Analisar dentro; o foco contorna a pílula inteira.",
      "html": "<div class=\"ds-linkpill\"><input type=\"url\" aria-label=\"Link do relatório no Warcraft Logs\" placeholder=\"https://www.warcraftlogs.com/reports/...\" /><button>Analisar</button></div>",
      "css": ".ds-linkpill{display:flex;align-items:center;gap:8px;max-width:720px;padding:5px;border-radius:999px;border:1px solid var(--border-control);background:var(--glass);backdrop-filter:blur(14px);}.ds-linkpill:has(input:focus-visible){outline:2px solid var(--focus);outline-offset:3px;}.ds-linkpill input{flex:1;min-width:0;min-height:44px;padding:0 18px;border:0;border-radius:999px;background:transparent;color:var(--text);font:inherit;font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;outline:none;}.ds-linkpill button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;font:inherit;font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;font-weight:600;cursor:pointer;transition:background-color .2s ease,border-color .2s ease;min-height:48px;padding:0 28px;background:var(--accent);border:1px solid var(--accent);color:var(--accent-ink);}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo em pílula com rótulo acima e erro abaixo.",
      "html": "<input class=\"ds-input\" type=\"email\" aria-label=\"E-mail\" />",
      "css": ".ds-input{width:100%;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--border-control);background:var(--bg);color:var(--text);font:inherit;font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;}.ds-input:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Cabeçalho de três pontos",
      "kind": "nav",
      "refersTo": "",
      "description": "Marca larga, contexto apagado no centro, navegação em pílulas e chave de tema.",
      "html": "<header class=\"ds-top\"><a class=\"ds-brand\" href=\"#\">LogCoach</a><p class=\"ds-ctx\">Coach de logs para Mago Arcano</p><nav class=\"ds-nav\"><a class=\"ds-nav-on\" href=\"#\">Analisar</a><a href=\"#\">Planos</a><button class=\"ds-switch\" aria-label=\"Ativar tema claro\"><span><i></i></span></button></nav></header>",
      "css": ".ds-top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px;font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;}.ds-brand{color:var(--text);font-size:1.125rem;font-stretch:125%;font-weight:800;letter-spacing:.02em;text-transform:uppercase;text-decoration:none;}.ds-ctx{margin:0;color:var(--muted);font-size:.875rem;}.ds-nav{justify-self:end;display:flex;align-items:center;gap:4px;}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 14px;border-radius:999px;color:var(--muted);text-decoration:none;}.ds-nav a:hover,.ds-nav .ds-nav-on{color:var(--text);background:var(--glass-2);}.ds-switch{display:grid;place-items:center;min-width:56px;min-height:44px;border:0;background:none;cursor:pointer;}.ds-switch span{display:flex;align-items:center;width:52px;height:30px;padding:3px;box-sizing:border-box;border-radius:999px;background:var(--glass-2);border:1px solid var(--border-control);}.ds-switch i{width:22px;height:22px;border-radius:50%;background:var(--text);}"
    },
    {
      "name": "Selos de situação",
      "kind": "chip",
      "refersTo": "badge-error",
      "description": "Situação sempre com símbolo desenhado e palavra.",
      "html": "<span class=\"ds-badge ds-erro\"><svg viewBox=\"0 0 24 24\" width=\"1em\" height=\"1em\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6.5 6.5 17.5 17.5\"/><path d=\"M17.5 6.5 6.5 17.5\"/></svg> Erro</span> <span class=\"ds-badge ds-atencao\"><svg viewBox=\"0 0 24 24\" width=\"1em\" height=\"1em\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v9\"/><path d=\"M12 19h.01\"/></svg> Atenção</span> <span class=\"ds-badge ds-ok\">Kill</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:999px;font-size:.8125rem;font-weight:600;white-space:nowrap;}.ds-erro{background:var(--error-bg);color:var(--error);}.ds-atencao{background:var(--warn-badge-bg);color:var(--warn-badge-fg);}.ds-ok{background:var(--ok-bg);color:var(--ok);}"
    },
    {
      "name": "Painel de vidro",
      "kind": "card",
      "refersTo": "panel",
      "description": "Contêiner translúcido com desfoque leve; sólido sem suporte.",
      "html": "<section class=\"ds-panel\"><h3>Grátis</h3><p>5 análises por mês</p></section>",
      "css": ".ds-panel{display:grid;gap:12px;padding:20px;border-radius:16px;background:var(--surface);border:1px solid var(--glass-border);color:var(--text);}@supports (backdrop-filter:blur(1px)){.ds-panel{background:var(--glass);backdrop-filter:blur(14px) saturate(1.15);}}.ds-panel h3,.ds-panel p{margin:0;}"
    },
    {
      "name": "Cartão de erro",
      "kind": "custom",
      "refersTo": "mistake-card",
      "description": "Número da posição grande na cor da situação, título, custo e o que fazer; sem faixa lateral.",
      "html": "<article class=\"ds-mistake\" id=\"erro-1\"><span class=\"ds-rank\" aria-hidden=\"true\">1</span><div><h3>Entrada na Alma Arcana com pouca Saraivada</h3><p class=\"ds-impact\">Custou cerca de 2,7% do seu dano</p><div class=\"ds-todo\"><strong>O que fazer</strong><p>Chegue à Alma Arcana com 20 de Saraivada ou mais.</p></div></div></article>",
      "css": ".ds-mistake{display:flex;gap:16px;padding:22px 24px;border-radius:16px;background:var(--glass);border:1px solid var(--glass-border);color:var(--text);font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;}.ds-rank{color:var(--error);font-size:2.75rem;font-stretch:125%;font-weight:800;line-height:.9;}.ds-mistake h3,.ds-mistake p{margin:0;}.ds-impact{font-weight:650;margin:8px 0!important;}.ds-todo{padding:12px 14px;border-radius:8px;background:var(--surface-2);}"
    },
    {
      "name": "Trilho dos erros",
      "kind": "nav",
      "refersTo": "mistake-rail",
      "description": "Pílula vertical translúcida com um link por erro, na ordem de custo.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Erros por custo\"><a href=\"#erro-1\" class=\"ds-r-erro\" aria-current=\"true\" aria-label=\"1. Entrada na Alma Arcana com pouca Saraivada\">1</a><a href=\"#erro-2\" class=\"ds-r-atencao\" aria-label=\"2. Impactos Arcanos demais dentro do Surto\">2</a><a href=\"#erro-3\" class=\"ds-r-atencao\" aria-label=\"3. Tempo ativo abaixo dos tops\">3</a></nav>",
      "css": ".ds-rail{display:inline-flex;flex-direction:column;gap:4px;padding:6px;border-radius:28px;background:var(--glass-2);border:1px solid var(--glass-border);backdrop-filter:blur(16px);font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;}.ds-rail a{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;font-weight:800;font-stretch:118%;text-decoration:none;}.ds-r-erro{color:var(--error);}.ds-r-atencao{color:var(--warn-fg);}.ds-rail a[aria-current=\"true\"]{background:var(--bg);box-shadow:inset 0 0 0 2px currentcolor;}"
    },
    {
      "name": "Decomposição da diferença",
      "kind": "custom",
      "refersTo": "",
      "description": "A frase sob a luz e a barra de erros, azar e não explicado.",
      "html": "<div class=\"ds-gap\"><p>Os tops fizeram <strong>18% mais dano</strong> que você.</p><div class=\"ds-gapbar\"><span style=\"width:37%;background:var(--error)\"></span><span style=\"width:53%;background:var(--luck)\"></span><span style=\"width:10%;background:var(--muted)\"></span></div></div>",
      "css": ".ds-gap{display:grid;gap:16px;font-family:\"Archivo Variable\",\"Archivo Fallback\",system-ui,sans-serif;}.ds-gap p{margin:0;color:var(--text);font-size:2.125rem;font-stretch:118%;font-weight:750;line-height:1.15;}.ds-gap strong{color:var(--error);font-weight:800;}.ds-gapbar{display:flex;gap:2px;height:14px;border-radius:999px;overflow:hidden;background:var(--surface-2);}"
    },
    {
      "name": "Trilha da linha do tempo",
      "kind": "custom",
      "refersTo": "",
      "description": "Jogador acima e tops abaixo, no mesmo eixo.",
      "html": "<div class=\"ds-track\"><i class=\"ds-me\" style=\"left:20%\"></i><i class=\"ds-me\" style=\"left:62%\"></i><i class=\"ds-top\" style=\"left:18%\"></i><i class=\"ds-top\" style=\"left:58%\"></i></div>",
      "css": ".ds-track{position:relative;height:44px;border-radius:6px;background:linear-gradient(var(--border),var(--border)) 0 50%/100% 1px no-repeat,var(--bg);}.ds-track i{position:absolute;width:6px;height:14px;border-radius:2px;transform:translateX(-50%);}.ds-me{top:5px;background:var(--player);}.ds-top{bottom:5px;background:var(--top);}"
    }
  ],
  "narrative": {
    "northStar": "A Sala com uma Lâmpada",
    "overview": "Cada tela é um quarto escuro (ou, no tema claro, uma sala ao sol) com uma única fonte de luz quente, e ela cai sobre o que importa ali. Na tela inicial, sobre o título e o campo do link. No resultado, sobre a frase da diferença para os tops (\"Os tops fizeram 18% mais dano que você\"), que acende antes de tudo; logo abaixo vêm os erros em ordem de custo, cada um com o número da posição grande, e um trilho numerado leva de um para o outro. O log do jogador é o objeto sob a luz.\n\nO resto fica quieto: fundo liso, painéis translúcidos por onde a luz passa, texto neutro, e a cor só aparece em ação ou em diagnóstico. A marca é tipográfica, \"LOGCOACH\" em caixa alta numa sans larga e pesada, e o cabeçalho tem três pontos: marca, contexto apagado no centro e a chave de tema em pílula. A confiança continua vindo de deixar claro o que é erro, o que é sorte e o que é hipótese.\n\nO vocabulário veio da inspiração do usuário (o site \"Five Years\" do estúdio Porto Rocha): a luz única, a marca larga, o cabeçalho de três pontos, o trilho numerado translúcido e o vazio generoso. Ficaram de fora a fotografia e tudo o que não é dado do produto.\n\nReferências rejeitadas: o painel de estatísticas em cartões iguais, a planilha crua de log, o painel de IA genérico (faíscas, degradês roxos), o visual gamer agressivo (neon, ângulos cortados, fontes de esport) e, do imaginário de fantasia, as fontes medievais e o pergaminho.",
    "keyCharacteristics": [
      "Uma luz quente por tela (`.lit`), presa ao assunto dela; fundo da página liso em `--bg`.",
      "Painéis e pílulas translúcidos com desfoque leve, e fundo sólido quando o navegador não tem `backdrop-filter`.",
      "Uma família, a Archivo variável: larga para a marca, os títulos e os números; normal para a leitura.",
      "Coluna de leitura de 960 px dentro de uma moldura de 1240 px (cabeçalho e rodapé).",
      "Controles em pílula, contêineres com cantos de 16 px.",
      "Verde, âmbar e vermelho reservados para situação; jogador laranja, tops ciano."
    ],
    "rules": [
      {
        "name": "Regra da Situação Fixa",
        "body": "Verde é ok, âmbar é atenção e vermelho é erro, em qualquer tema e em qualquer tela. Essas cores não servem de decoração.",
        "section": "colors"
      },
      {
        "name": "Regra da Situação Inconfundível",
        "body": "Ok, atenção e erro se distinguem entre si e das outras cores do sistema, com distância medida pelo teste. Com daltonismo, quem garante a leitura é o símbolo e a palavra do selo.",
        "section": "colors"
      },
      {
        "name": "Regra do Destaque que Preenche",
        "body": "`--accent` só preenche. Quando o destaque vira texto, borda ou traço, usa-se `--accent-fg`.",
        "section": "colors"
      },
      {
        "name": "Regra do Você e dos Tops",
        "body": "O jogador é sempre laranja e os melhores são sempre ciano.",
        "section": "colors"
      },
      {
        "name": "Regra da Lâmpada Única",
        "body": "Uma `.lit` por tela, no assunto dela. Duas luzes viram decoração; luz atrás de texto nunca passa de `--glow-1`.",
        "section": "colors"
      },
      {
        "name": "Regra do Número em Negrito",
        "body": "O custo e a diferença aparecem em peso forte, dentro de uma frase em português. O número nunca fica solto sem dizer o que significa.",
        "section": "typography"
      },
      {
        "name": "Regra do Boletim",
        "body": "Diagnóstico primeiro, erros por custo depois, dados completos por último. Nada novo entra acima da decomposição da diferença.",
        "section": "layout"
      },
      {
        "name": "Regra do Vidro com Reserva",
        "body": "Fundo translúcido só dentro de `@supports (backdrop-filter: ...)`; fora dele, o painel é sólido.",
        "section": "elevation"
      },
      {
        "name": "Regra da Pílula e do Painel",
        "body": "O que se aciona é pílula (botões, campos, navegação, chave de tema, selos, trilho); o que contém tem cantos de 16 px (painéis, cartões de erro, avisos, tabelas). Borda tracejada continua indicando estado provisório: luta subindo, upload pausado, recurso que ainda vai chegar.",
        "section": "shapes"
