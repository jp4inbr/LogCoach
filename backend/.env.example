WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# De onde vêm os relatórios: wcl (API real) ou exemplo (sem internet).
# Vazio = wcl quando as duas chaves do WCL estão preenchidas, senão exemplo.
DATA_SOURCE=
GOOGLE_CLOUD_PROJECT=
DATABASE_URL=sqlite:///./logcoach.db
# Chave para assinar o login. Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Obrigatória com APP_ENV=prod (em dev, vazia = chave temporária).
JWT_SECRET=
APP_ENV=dev
